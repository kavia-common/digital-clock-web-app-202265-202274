{
  "name": "digital_clock_frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Digital clock web app (React 17) that displays current time and updates every second.",
  "dependencies": {
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "test": "react-scripts test --watchAll=false"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
